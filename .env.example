# Environment variables for distributed ML pipeline
# PostgreSQL Configuration
POSTGRES_USER=ml_user
POSTGRES_PASSWORD=ml_password_secure_123
POSTGRES_DB=secom_pipeline
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_TOPIC=secom-raw-data
KAFKA_PREPROCESSED_TOPIC=secom-preprocessed-data
KAFKA_DLQ_TOPIC=secom-dead-letter-queue
KAFKA_CONSUMER_GROUP=secom-preprocessor-group
KAFKA_AUTO_OFFSET_RESET=earliest

# Model Paths
SDV_MODEL_PATH=./models/sdv_secom_raw.joblib
PREPROCESSING_PIPELINE_PATH=./models/preprocessing_pipeline.joblib

# Data Generator Configuration
BATCH_SIZE=100
GENERATION_INTERVAL_SECONDS=5
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2

# Monitoring
PROMETHEUS_PORT=8000
LOG_LEVEL=INFO
METRICS_ENABLED=true

# pgAdmin
PGADMIN_EMAIL=admin@secom.local
PGADMIN_PASSWORD=admin

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
