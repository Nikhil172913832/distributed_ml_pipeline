name: Model Training Pipeline

on:
  schedule:
    # Run weekly on Sunday at 2 AM UTC
    - cron: '0 2 * * 0'
  workflow_dispatch:
    inputs:
      epochs:
        description: 'Number of training epochs'
        required: false
        default: '100'
      batch_size:
        description: 'Batch size'
        required: false
        default: '64'

jobs:
  train:
    name: Train Model
    runs-on: ubuntu-latest
    steps:
    - uses: actions/checkout@v3
    
    - name: Set up Python
      uses: actions/setup-python@v4
      with:
        python-version: '3.10'
    
    - name: Install dependencies
      run: |
        python -m pip install --upgrade pip
        pip install -r requirements.txt
    
    - name: Configure training
      run: |
        echo "Training with epochs=${{ github.event.inputs.epochs || '100' }}"
        echo "Batch size=${{ github.event.inputs.batch_size || '64' }}"
    
    - name: Run training
      run: |
        python pipeline/model_trainer.py \
          --epochs ${{ github.event.inputs.epochs || '100' }} \
          --batch-size ${{ github.event.inputs.batch_size || '64' }}
      continue-on-error: true
    
    - name: Upload model artifacts
      uses: actions/upload-artifact@v3
      with:
        name: trained-model
        path: |
          models/
          checkpoints/
        retention-days: 30
    
    - name: Create model release
      uses: actions/create-release@v1
      if: success()
      env:
        GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
      with:
        tag_name: model-${{ github.run_number }}
        release_name: Model Release ${{ github.run_number }}
        body: |
          Automated model training completed
          Epochs: ${{ github.event.inputs.epochs || '100' }}
          Batch size: ${{ github.event.inputs.batch_size || '64' }}
        draft: false
        prerelease: false
      continue-on-error: true
